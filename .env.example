# MediTrace 2.1 Configuration
APP_ENV=development
APP_NAME=MediTrace
DEBUG=true
PORT=8000

# Security
SECRET_KEY=your_secret_key_here
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Database
DATABASE_URL=sqlite+aiosqlite:///./meditrace.db
# DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/meditrace

# Storage
STORAGE_TYPE=local
STORAGE_DIR=./storage_data

# AI / Models
GEMINI_API_KEY=
GOOGLE_API_KEY=
LLM_MODEL=gemini-2.5-flash
EMBEDDING_MODEL=text-embedding-004

# LiveKit Voice Agent
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# Notifications
NOTIFY_SMS_DLT_ENTITY_ID=
NOTIFY_WHATSAPP_TOKEN=
